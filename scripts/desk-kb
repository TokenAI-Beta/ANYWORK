#!/usr/bin/env python3
# desk-kb：把笔记沉淀进团队共享知识库（供工作台里的 agent / 成员使用）
# 用法：
#   desk-kb "标题" "正文"
#   desk-kb "标题"            （正文从 stdin 读，适合长文/多行）
#   desk-kb list [N]          （最近 N 条，默认 10）
#   desk-kb search 关键词     （全文检索，最多 20 条命中）
import json
import os
import sys
import urllib.parse
import urllib.request

BASE = "http://127.0.0.1:8080"
TOKEN_PATH = os.path.expanduser("~/desk-data/notify.token")


def token():
    try:
        with open(TOKEN_PATH) as f:
            return f.read().strip()
    except OSError:
        return ""


def call(method, path, body=None, params=None):
    url = BASE + path
    if params:
        url += "?" + urllib.parse.urlencode(params)
    data = json.dumps(body).encode("utf-8") if body is not None else None
    headers = {"content-type": "application/json", "x-desk-notify-token": token()}
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    with urllib.request.urlopen(req, timeout=30) as r:
        return r.status, json.loads(r.read().decode("utf-8"))


def main():
    args = sys.argv[1:]
    if not args:
        print('用法：desk-kb "标题" "正文" ｜ desk-kb "标题"（stdin 读正文）｜ desk-kb list [N] ｜ desk-kb search 关键词')
        return 1

    if args[0] == "list":
        n = int(args[1]) if len(args) > 1 and args[1].isdigit() else 10
        try:
            _, d = call("GET", "/portal/api/kb/list")
        except Exception as e:  # noqa: BLE001
            print("desk-kb 读取失败：%s" % e)
            return 1
        notes = d.get("notes", [])[:n]
        if not notes:
            print("（知识库还没有沉淀笔记）")
            return 0
        for it in notes:
            print("%s · %s · %s" % (it.get("mtime", ""), it.get("author", ""), it.get("title", "")))
        return 0

    if args[0] == "search":
        q = " ".join(args[1:]).strip()
        if not q:
            print("用法：desk-kb search 关键词")
            return 1
        try:
            _, d = call("GET", "/portal/api/kb/search", params={"q": q})
        except Exception as e:  # noqa: BLE001
            print("desk-kb 检索失败：%s" % e)
            return 1
        hits = d.get("hits", [])
        print("命中 %d 条（截断=%s）" % (len(hits), d.get("truncated")))
        for hh in hits:
            print("  %s:%s  %s" % (hh.get("file"), hh.get("line"), hh.get("text", "")[:120]))
        return 0

    # 沉淀模式
    title, content = "", ""
    if len(args) >= 2:
        title, content = args[0], args[1]
    else:
        title = args[0]
        content = sys.stdin.read().strip()
    if not content:
        print('内容为空。用法：desk-kb "标题" "正文"（或 desk-kb "标题" 后从 stdin 输入）')
        return 1
    body = {"title": title, "content": content, "author": "agent"}
    try:
        _, d = call("POST", "/portal/api/kb/save", body=body)
    except Exception as e:  # noqa: BLE001
        print("desk-kb 保存失败：%s" % e)
        return 1
    if d.get("ok"):
        print("✓ 已沉淀：notes/%s" % d.get("name"))
        return 0
    print("✗ 保存被拒：%s" % d.get("error"))
    return 1


if __name__ == "__main__":
    sys.exit(main())
