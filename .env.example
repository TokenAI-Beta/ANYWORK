# ── DSH-ANYWORK 配置模板：复制为 .env 后按注释修改；.env 已被 gitignore，不要提交 ──

# 【必填】你访问工作台用的地址（浏览器地址栏里用的那个），带端口：
#   局域网 IP：      192.168.1.50:8080
#   域名（有反代）：  workbench.example.com  或  workbench.example.com:8080
ANYWORK_HOST=192.168.1.50:8080

# 【必填】DeepSeek 真 key（只留在服务器；成员拿到的都是虚拟钥匙）
DEEPSEEK_API_KEY=sk-在这里填你的真key

# 管理员账号（默认 boss）；密码留空则首次启动自动生成并打印一次
ANYWORK_ADMIN_USER=boss
ANYWORK_ADMIN_PASSWORD=

# 【可选】额外成员（逗号分隔）；首次启动自动建号、配实例、生成初始密码
# 初始密码落盘在数据卷 .desk/accounts.txt 里，转告本人后可删
# ANYWORK_MEMBERS=alice,bob

# 【可选】额外信任地址（逗号分隔；一般不需要——只填 ANYWORK_HOST 即可）
# ANYWORK_TRUSTED_HOSTS=my.second.domain

# 【可选】对外端口（默认 8080）
ANYWORK_PORT=8080

TZ=Asia/Shanghai
