{
  "name": "dsh-agents-md",
  "version": "0.1.0",
  "private": true,
  "description": "agents/*.md 子代理定义桥：把 Markdown 定义的子代理接入 dsh subagent 委派体系（零依赖 host 组合插件）。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
