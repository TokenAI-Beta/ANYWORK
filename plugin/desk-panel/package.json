{
  "name": "dsh-desk-panel",
  "version": "0.2.0",
  "private": true,
  "description": "DSH-ANYWORK workbench panel for dsh 0.2.1-rc.3: settings and sidebar pages wired to the portal. Client-side dsh plugin — no dsh source changes.",
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT"
}
